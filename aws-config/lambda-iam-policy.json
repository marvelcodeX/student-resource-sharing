{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ResourcesTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Scan",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/StudentResources"
    },
    {
      "Sid": "ResourceFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::FILES_BUCKET_NAME/*"
    }
  ]
}
